FLASK_ENV=development
FLASK_CONFIG=development

# Flask secret key
# IMPORTANT: Set this to a strong random value in production and Docker.
SECRET_KEY=change-me-in-production

# Database configuration
# These values are shared between local development and Docker Compose.
DB_NAME=hawkeye_db
DB_USER=hawkeye_user
DB_PASSWORD=CHANGE_ME_PASSWORD

# Application DATABASE_URL used by Flask.
# When using Docker Compose, these values will also be used inside the container.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}
# For running the app via Docker Compose, the web container uses a DATABASE_URL
# constructed from DB_NAME/DB_USER/DB_PASSWORD with the host set to \"db\".

# Google Maps (Places Autocomplete, map pin for incident location)
# Get a key at https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=

# Mail settings (for notifications)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SUPPRESS_SEND=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=hawkeye@example.com
APP_BASE_URL=http://127.0.0.1:5000

# Resend (https://resend.com) — used when RESEND_API_KEY is set for:
# registration verification, password reset, incident emails, department dispatch.
# Without a key, the app falls back to SMTP (MAIL_* / MailHog in Docker).
# Use a verified domain sender in production (e.g. onboarding@yourdomain.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: set to false to allow login without verifying (not recommended for production).
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TOKEN_DAYS=7

# Dispatch / escalation behavior
DISPATCH_AUTO_ESCALATION_ENABLED=true
DISPATCH_REMINDER_STALE_MINUTES=60
DISPATCH_REMINDER_RETRY_COOLDOWN_MINUTES=30
DISPATCH_MAX_REMINDERS=3

# Optional admin bootstrap overrides (dev/demo)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=System Admin
